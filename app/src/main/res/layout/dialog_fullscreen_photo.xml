<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2000000">

    <ImageView
        android:id="@+id/fullPhotoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:contentDescription="Full photo — pinch to zoom" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:text="Pinch to zoom • Tap ✕ to close"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/btnClosePhoto"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="#80000000"
        android:contentDescription="Close full photo" />

</FrameLayout>
